# Conexão Supabase (URL e chave pública; sem chaves secretas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-mails transacionais do espaço do cliente (somente no servidor).
APP_URL=https://denisramos.vercel.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Prospecção: variáveis apenas no servidor, nunca prefixar com NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
# Senha aleatória de pelo menos 32 caracteres. Digitada na tela de prospecção.
PROSPECTING_ACCESS_TOKEN=
